[Unit]
Description=Load the Quark Anticheat Ring-0 kernel module
# No explicit ordering against quark.socket: an earlier `Before=quark.socket` here
# created a real systemd ordering cycle (quark.socket is pulled in by
# sockets.target, ahead of basic.target, while this unit's default dependencies put
# it after basic.target -- systemd detects the cycle and silently drops the
# ordering, so it was doing nothing anyway). Not a hard dependency in the first
# place: quark.service/quark.socket work fine (fail closed, via the ack/nack
# handshake in quark_sdk_init()) whether this has run yet or not -- they just
# refuse to confirm protection instead of silently pretending to be protected.
# This unit exists purely so a reboot doesn't leave the module unloaded
# indefinitely until someone notices, not to guarantee load-before-socket.

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust to wherever this repo is actually checked out, and to whichever .ko
# was built for this box:
#   kernel/quark_kernel.ko          (release -- `make -C kernel`, refuses to
#                                     protect anything running inside a VM)
#   a `make -C kernel testing` build (bypasses that check -- only appropriate
#                                     on a hypervisor-guest test rig, like
#                                     this project's own VM; see
#                                     docs/vm_test_environment.md #12)
Environment=QUARK_KERNEL_MODULE=/opt/quark-anticheat/kernel/quark_kernel.ko
ExecStart=/bin/sh -c 'lsmod | grep -q "^quark_kernel " || /usr/sbin/insmod "$QUARK_KERNEL_MODULE"'
ExecStop=/usr/sbin/rmmod quark_kernel

[Install]
WantedBy=multi-user.target
